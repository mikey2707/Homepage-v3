---
import Layout from '../layouts/Layout.astro';
import { getSession } from '../lib/auth';

const session = getSession(Astro.cookies);
const iconBase = "https://cdn.jsdelivr.net/gh/walkxcode/dashboard-icons/png";
---

<Layout title="Homelab 84 • Read-Only Telemetry Dashboard | Michael Chavez">
  <div class="min-h-screen bg-[#07050a] text-slate-200 font-sans selection:bg-purple-600 selection:text-white pb-16">
    
    <!-- Top Cockpit Atmospheric Glow -->
    <div class="fixed top-0 inset-x-0 h-96 bg-gradient-to-b from-purple-900/15 via-indigo-950/10 to-transparent pointer-events-none z-0"></div>
    <div class="fixed inset-0 opacity-10 pointer-events-none z-0" style="background-size: 40px 40px; background-image: linear-gradient(to right, rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.05) 1px, transparent 1px);"></div>

    <!-- MAIN COMMAND COCKPIT HEADER (Non-sticky so it scrolls naturally with the page) -->
    <header class="relative z-10 border-b border-purple-500/20 bg-[#0c0814]/90 backdrop-blur-xl px-4 sm:px-8 py-3.5 shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
      <div class="max-w-[1720px] mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
        
        <!-- Left: Brand / Cluster Identity -->
        <div class="flex items-center gap-3.5">
          <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-purple-600 via-indigo-600 to-amber-500 shadow-lg shadow-purple-900/50 p-0.5">
            <div class="w-full h-full bg-[#0e0a19] rounded-[10px] flex items-center justify-center">
              <span class="text-lg">⚡</span>
            </div>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-base sm:text-lg font-bold tracking-tight text-white font-mono flex items-center gap-2">
                HOMELAB 84 <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 uppercase tracking-widest font-mono font-bold animate-pulse">● LIVE PROD</span>
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-500/15 text-blue-300 border border-blue-500/30 uppercase tracking-wider font-mono">2 PHYSICAL SERVERS</span>
              </h1>
            </div>
            <p class="text-[11px] text-slate-400 font-mono tracking-wide hidden sm:block">
              Server 1 (truenas): TrueNAS SCALE • Threadripper 3970X 32c/64t • 251.6 GiB RAM • 55.4 TiB ZFS &nbsp;|&nbsp; Server 2 (pve01): Proxmox VE 9 • Intel 2.8GHz • 64 GiB DDR4
            </p>
          </div>
        </div>

        <!-- Center: TrueNAS Cooler Thermals Indicator -->
        <div class="hidden xl:flex items-center gap-3 px-4 py-1.5 rounded-full bg-black/60 border border-cyan-500/30 text-xs font-mono">
          <span class="text-cyan-400 text-sm">❄️</span>
          <span class="text-slate-400">Walk-In Fridge Die Sync:</span>
          <span id="header-fridge-temp" class="text-emerald-400 font-bold">38.2°C // 100.8°F</span>
          <span class="text-[10px] px-2 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800">COOLING [OK]</span>
        </div>

        <!-- Right: Actions, Auto-Refresh & Nav -->
        <div class="flex items-center gap-2.5 sm:gap-3 flex-wrap justify-end">
          
          <!-- Auto-Refresh Selector -->
          <div class="flex items-center bg-white/[0.04] border border-white/10 rounded-xl p-1 text-xs font-mono">
            <label for="poll-interval" class="px-2 text-slate-400 text-[11px]">Sync:</label>
            <select id="poll-interval" class="bg-black/80 text-white rounded-lg px-2 py-1 text-xs border border-white/10 focus:outline-none focus:border-purple-500 cursor-pointer">
              <option value="15000">15s</option>
              <option value="30000" selected>30s</option>
              <option value="60000">60s</option>
              <option value="0">Manual</option>
            </select>
          </div>

          <!-- Refresh Now Button -->
          <button
            id="refresh-all-btn"
            class="px-3.5 py-1.5 rounded-xl bg-purple-600/30 hover:bg-purple-600 text-purple-200 hover:text-white border border-purple-500/40 text-xs font-mono font-bold transition-all duration-200 flex items-center gap-1.5 shadow-md hover:scale-105 active:scale-95 cursor-pointer"
          >
            <svg id="refresh-spinner" class="w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span id="refresh-label">Refresh</span>
          </button>

          <!-- Return to 3D Pizzeria -->
          <a
            href="/"
            class="px-3.5 py-1.5 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 border border-amber-500/30 text-xs font-mono font-semibold transition-all duration-200 flex items-center gap-1.5 hover:scale-105 active:scale-95 shadow-md"
            title="Return to the 3D Pizzeria Diorama"
          >
            <span>🍕</span>
            <span>Back to Pizzeria</span>
          </a>

          <!-- Logout -->
          {session && (
            <a
              href="/api/auth/logout"
              class="px-3 py-1.5 rounded-xl bg-rose-500/15 hover:bg-rose-500/30 text-rose-300 border border-rose-500/30 text-xs font-mono transition-colors"
              title="End Master Session"
            >
              Logout
            </a>
          )}
        </div>

      </div>
    </header>

    <!-- MAIN BODY CONTAINER -->
    <main class="relative z-10 max-w-[1720px] mx-auto px-4 sm:px-8 pt-6 space-y-8">

      <!-- ===================================================== -->
      <!-- DUAL BARE-METAL SERVER ARCHITECTURE OVERVIEW          -->
      <!-- ===================================================== -->
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- PHYSICAL SERVER 1 SUMMARY -->
        <div class="rounded-2xl bg-gradient-to-br from-purple-950/35 via-[#0f0c18]/95 to-[#0f0c18]/95 border border-purple-500/40 p-4 sm:p-5 backdrop-blur-xl shadow-xl flex flex-col justify-between">
          <div class="flex items-start justify-between gap-3 pb-3 border-b border-white/10">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 rounded-lg bg-purple-500/20 border border-purple-400/40 text-purple-300 font-mono text-xs font-bold">SERVER 01</span>
              <div>
                <h2 class="text-sm sm:text-base font-bold text-white font-mono">TrueNAS SCALE Storage &amp; Media Server (truenas)</h2>
                <p class="text-[11px] text-slate-400 font-mono">Dedicated Bare-Metal ZFS Appliance • OS: TrueNAS SCALE 25.04.2.3</p>
              </div>
            </div>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-mono font-bold">BARE-METAL #1</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-3 text-xs font-mono">
            <div class="p-2.5 rounded-xl bg-black/40 border border-white/5">
              <span class="text-[10px] text-slate-400 block uppercase">CPU Hardware</span>
              <span class="text-white font-bold block mt-0.5">Threadripper 3970X</span>
              <span class="text-[10px] text-purple-300">32 Cores / 64 Threads</span>
            </div>
            <div class="p-2.5 rounded-xl bg-black/40 border border-white/5">
              <span class="text-[10px] text-slate-400 block uppercase">System Memory</span>
              <span class="text-white font-bold block mt-0.5">251.6 GiB RAM</span>
              <span class="text-[10px] text-indigo-300">170.8 GiB ZFS ARC</span>
            </div>
            <div class="p-2.5 rounded-xl bg-black/40 border border-white/5">
              <span class="text-[10px] text-slate-400 block uppercase">ZFS Storage</span>
              <span class="text-white font-bold block mt-0.5">55.4 TiB Raw</span>
              <span class="text-[10px] text-emerald-400">3 Pools (19.5 TiB Used)</span>
            </div>
            <div class="p-2.5 rounded-xl bg-black/40 border border-white/5">
              <span class="text-[10px] text-slate-400 block uppercase">Motherboard / Role</span>
              <span class="text-white font-bold block mt-0.5">ASUS Workstation</span>
              <span class="text-[10px] text-amber-300">ZFS + Media &amp; AI Apps</span>
            </div>
          </div>
        </div>

        <!-- PHYSICAL SERVER 2 SUMMARY -->
        <div class="rounded-2xl bg-gradient-to-br from-cyan-950/35 via-[#0f0c18]/95 to-[#0f0c18]/95 border border-cyan-500/40 p-4 sm:p-5 backdrop-blur-xl shadow-xl flex flex-col justify-between">
          <div class="flex items-start justify-between gap-3 pb-3 border-b border-white/10">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 rounded-lg bg-cyan-500/20 border border-cyan-400/40 text-cyan-300 font-mono text-xs font-bold">SERVER 02</span>
              <div>
                <h2 class="text-sm sm:text-base font-bold text-white font-mono">Proxmox VE 9 Virtualization Hypervisor (pve01)</h2>
                <p class="text-[11px] text-slate-400 font-mono">Standalone Bare-Metal KVM/LXC Host • OS: Proxmox VE 9.0.5</p>
              </div>
            </div>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-mono font-bold">BARE-METAL #2</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-3 text-xs font-mono">
            <div class="p-2.5 rounded-xl bg-black/40 border border-white/5">
              <span class="text-[10px] text-slate-400 block uppercase">CPU Hardware</span>
              <span class="text-white font-bold block mt-0.5">Intel @ 2.80 GHz</span>
              <span class="text-[10px] text-cyan-300">8c/16t x86_64 KVM</span>
            </div>
            <div class="p-2.5 rounded-xl bg-black/40 border border-white/5">
              <span class="text-[10px] text-slate-400 block uppercase">System Memory</span>
              <span class="text-white font-bold block mt-0.5">64.0 GiB DDR4</span>
              <span class="text-[10px] text-indigo-300">38.4 GiB Allocated</span>
            </div>
            <div class="p-2.5 rounded-xl bg-black/40 border border-white/5">
              <span class="text-[10px] text-slate-400 block uppercase">Hypervisor Disk</span>
              <span class="text-white font-bold block mt-0.5">Local NVMe LVM</span>
              <span class="text-[10px] text-emerald-400">250+ GiB VM Store</span>
            </div>
            <div class="p-2.5 rounded-xl bg-black/40 border border-white/5">
              <span class="text-[10px] text-slate-400 block uppercase">Hosted Guests</span>
              <span class="text-white font-bold block mt-0.5">4 VMs / 2 LXCs</span>
              <span class="text-[10px] text-amber-300">docker1 (23 Containers)</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================================================== -->
      <!-- SECTION 1: SERVER 01 — TRUENAS SCALE POOLS & HARDWARE -->
      <!-- ===================================================== -->
      <section>
        <div class="flex items-center justify-between mb-3.5 pb-2 border-b border-purple-500/20">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-sm bg-purple-500 shadow-sm shadow-purple-500"></span>
            <h2 class="text-sm font-mono uppercase tracking-widest text-slate-300 font-bold">
              Server 01: TrueNAS SCALE // Storage Pools &amp; Hardware Telemetry (truenas)
            </h2>
          </div>
          <span class="text-[11px] font-mono text-purple-300">55.4 TiB Total ZFS • midclt pool.query</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-4">

          <!-- TRUENAS CPU & THERMALS -->
          <div class="rounded-2xl bg-[#0f0c18]/90 border border-purple-500/30 p-5 backdrop-blur-xl shadow-xl space-y-3">
            <div class="flex items-center gap-2.5 pb-2 border-b border-white/10">
              <img src={`${iconBase}/truenas.png`} alt="TrueNAS" class="w-7 h-7 object-contain" />
              <div>
                <h3 class="text-sm font-bold text-white font-mono flex items-center gap-1.5">
                  TrueNAS SCALE
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">ONLINE</span>
                </h3>
                <p class="text-[11px] text-slate-400 font-mono">Node: truenas • v25.04.2.3</p>
              </div>
            </div>

            <div class="space-y-2 text-xs font-mono bg-black/40 rounded-xl p-3 border border-white/5">
              <div class="flex justify-between items-center">
                <span class="text-slate-400">Processor:</span>
                <span class="text-white font-bold">AMD 3970X (32c/64t)</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-400">CPU Usage:</span>
                <span id="tn-cpu-usage" class="text-emerald-400 font-bold">0.1%</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-400">Die Temperature:</span>
                <span id="tn-die-temp" class="text-amber-300 font-bold">38.2°C // 100.8°F</span>
              </div>
              <div class="w-full bg-white/10 rounded-full h-1.5 overflow-hidden">
                <div class="bg-gradient-to-r from-emerald-500 to-amber-500 h-1.5 rounded-full" style="width: 38%;"></div>
              </div>
              <div class="flex justify-between items-center pt-1 text-[11px]">
                <span class="text-slate-400">Memory Total:</span>
                <span id="tn-ram-usage" class="text-white font-bold">66.6 GiB Free / 251.6 GiB</span>
              </div>
              <div class="w-full bg-white/10 rounded-full h-1.5 overflow-hidden">
                <div id="tn-ram-bar" class="bg-indigo-500 h-1.5 rounded-full" style="width: 73.5%;"></div>
              </div>
              <div class="flex justify-between text-[10px] text-slate-500 pt-0.5">
                <span>ZFS ARC Cache: <strong id="tn-arc" class="text-slate-300">170.8 GiB</strong></span>
                <span>Free: <strong id="tn-free-ram" class="text-emerald-400">66.6 GiB</strong></span>
              </div>
            </div>
          </div>

          <!-- POOL 1: VAULT (43.6 TiB) -->
          <div class="rounded-2xl bg-[#0f0c18]/90 border border-purple-500/30 p-5 backdrop-blur-xl shadow-xl flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h3 class="text-sm font-bold text-white font-mono flex items-center gap-1.5">
                    Vault
                    <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400">ONLINE</span>
                  </h3>
                  <p class="text-[11px] text-slate-400 font-mono">Primary Mass Archive Pool</p>
                </div>
                <span class="text-xs font-mono font-bold text-indigo-300">43.6 TiB</span>
              </div>

              <div class="my-3 space-y-1">
                <div class="flex justify-between text-xs font-mono">
                  <span class="text-slate-400">Used: <strong id="vault-used" class="text-slate-200">19.2 TiB</strong></span>
                  <span id="vault-pct" class="text-indigo-400 font-bold">44.0%</span>
                </div>
                <div class="w-full bg-white/10 rounded-full h-2.5 overflow-hidden">
                  <div id="vault-bar" class="bg-gradient-to-r from-indigo-500 to-purple-500 h-2.5 rounded-full" style="width: 44.0%;"></div>
                </div>
                <div class="flex justify-between text-[10px] font-mono text-slate-500 pt-1">
                  <span>Available: 24.4 TiB</span>
                  <span>ZFS 4x 2-Way Mirror (8 Disks)</span>
                </div>
              </div>
            </div>
            <div class="text-[10px] font-mono text-slate-400 bg-white/[0.02] p-2 rounded-lg border border-white/5">
              midclt: pool.query: Vault • Health: ONLINE (0 errors)
            </div>
          </div>

          <!-- POOL 2: LIBRARY (7.3 TiB) -->
          <div class="rounded-2xl bg-[#0f0c18]/90 border border-purple-500/30 p-5 backdrop-blur-xl shadow-xl flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h3 class="text-sm font-bold text-white font-mono flex items-center gap-1.5">
                    Library
                    <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400">ONLINE</span>
                  </h3>
                  <p class="text-[11px] text-slate-400 font-mono">Media & Streaming Staging</p>
                </div>
                <span class="text-xs font-mono font-bold text-purple-300">7.3 TiB</span>
              </div>

              <div class="my-3 space-y-1">
                <div class="flex justify-between text-xs font-mono">
                  <span class="text-slate-400">Used: <strong id="lib-used" class="text-slate-200">201.2 GiB</strong></span>
                  <span id="lib-pct" class="text-purple-400 font-bold">2.7%</span>
                </div>
                <div class="w-full bg-white/10 rounded-full h-2.5 overflow-hidden">
                  <div id="lib-bar" class="bg-gradient-to-r from-purple-500 to-pink-500 h-2.5 rounded-full" style="width: 2.7%;"></div>
                </div>
                <div class="flex justify-between text-[10px] font-mono text-slate-500 pt-1">
                  <span>Available: 7.1 TiB</span>
                  <span>High-Bandwidth Media Staging</span>
                </div>
              </div>
            </div>
            <div class="text-[10px] font-mono text-slate-400 bg-white/[0.02] p-2 rounded-lg border border-white/5">
              midclt: pool.query: Library • Health: ONLINE (0 errors)
            </div>
          </div>

          <!-- POOL 3: SSD-LOCKER (4.5 TiB) -->
          <div class="rounded-2xl bg-[#0f0c18]/90 border border-purple-500/30 p-5 backdrop-blur-xl shadow-xl flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h3 class="text-sm font-bold text-white font-mono flex items-center gap-1.5">
                    SSD-Locker
                    <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400">ONLINE</span>
                  </h3>
                  <p class="text-[11px] text-slate-400 font-mono">NVMe High-IOPS Scratch & VMs</p>
                </div>
                <span class="text-xs font-mono font-bold text-amber-300">4.5 TiB</span>
              </div>

              <div class="my-3 space-y-1">
                <div class="flex justify-between text-xs font-mono">
                  <span class="text-slate-400">Used: <strong id="ssd-used" class="text-slate-200">88.5 GiB</strong></span>
                  <span id="ssd-pct" class="text-amber-400 font-bold">1.9%</span>
                </div>
                <div class="w-full bg-white/10 rounded-full h-2.5 overflow-hidden">
                  <div id="ssd-bar" class="bg-gradient-to-r from-amber-500 to-emerald-500 h-2.5 rounded-full" style="width: 1.9%;"></div>
                </div>
                <div class="flex justify-between text-[10px] font-mono text-slate-500 pt-1">
                  <span>Available: 4.4 TiB</span>
                  <span>All-Flash NVMe Array</span>
                </div>
              </div>
            </div>
            <div class="text-[10px] font-mono text-slate-400 bg-white/[0.02] p-2 rounded-lg border border-white/5">
              midclt: pool.query: SSD-Locker • Health: ONLINE (0 errors)
            </div>
          </div>

        </div>
      </section>

      <!-- ===================================================== -->
      <!-- SECTION 2: LIVE MEDIA ACTIVITY (Jellyfin & qBittorrent) -->
      <!-- ===================================================== -->
      <section>
        <div class="flex items-center justify-between mb-3.5 pb-2 border-b border-indigo-500/20">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-sm bg-indigo-500 shadow-sm shadow-indigo-500"></span>
            <h2 class="text-sm font-mono uppercase tracking-widest text-slate-300 font-bold">
              Live Stream & Torrent Activity // Jellyfin + qBittorrent (VPN Egress)
            </h2>
          </div>
          <span class="text-[11px] font-mono text-indigo-300">Real-Time Sessions & Bandwidth</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

          <!-- JELLYFIN ACTIVE STREAMS & LIBRARY -->
          <div class="rounded-2xl bg-[#0f0c18]/90 border border-indigo-500/30 p-5 backdrop-blur-xl shadow-xl flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3 pb-2 border-b border-white/10">
                <div class="flex items-center gap-2.5">
                  <img src={`${iconBase}/jellyfin.png`} alt="Jellyfin" class="w-7 h-7 object-contain" />
                  <div>
                    <h3 class="text-sm font-bold text-white font-mono flex items-center gap-1.5">
                      Jellyfin Media Server
                      <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400">ONLINE</span>
                    </h3>
                    <p class="text-[11px] text-slate-400 font-mono">Port :30013 • TrueNAS App</p>
                  </div>
                </div>
                <div class="text-right">
                  <span id="jf-active-badge" class="px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 text-xs font-mono font-bold">
                    0 Active Streams
                  </span>
                </div>
              </div>

              <!-- Quick Library Counts -->
              <div class="grid grid-cols-3 gap-2 text-center text-xs font-mono mb-3">
                <div class="p-2 rounded-xl bg-white/[0.03] border border-white/5">
                  <span class="text-[10px] text-slate-400 block uppercase">Movies</span>
                  <span id="jf-movies-count" class="text-base font-bold text-white">806</span>
                </div>
                <div class="p-2 rounded-xl bg-white/[0.03] border border-white/5">
                  <span class="text-[10px] text-slate-400 block uppercase">TV Series</span>
                  <span id="jf-series-count" class="text-base font-bold text-white">192</span>
                </div>
                <div class="p-2 rounded-xl bg-white/[0.03] border border-white/5">
                  <span class="text-[10px] text-slate-400 block uppercase">Episodes</span>
                  <span id="jf-episodes-count" class="text-base font-bold text-white">16,217</span>
                </div>
              </div>

              <!-- Specific Active Stream Sessions List -->
              <div class="space-y-1.5 text-xs font-mono">
                <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold block">Current Playback Sessions (/Sessions)</span>
                <div id="jf-viewers-list" class="space-y-2">
                  <div class="p-3 rounded-xl bg-black/40 border border-white/5 text-slate-500 text-center">
                    No active streams at the moment
                  </div>
                </div>
