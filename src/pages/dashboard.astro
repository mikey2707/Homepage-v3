<script>
  // Dashboard Live Read-Only Polling Engine
  let pollTimer: any = null;

  function escapeHtml(val: unknown): string {
    return String(val ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  async function updateTelemetry() {
    const spinner = document.getElementById('refresh-spinner');
    const label = document.getElementById('refresh-label');

    if (spinner) spinner.classList.add('animate-spin');
    if (label) label.textContent = 'Syncing...';

    try {
      const fetchJson = async (url: string) => {
        const res = await fetch(url);
        return res.ok ? res.json() : null;
      };

      // Fetch all 9 telemetry endpoints in parallel to eliminate sequential waterfall delays
      const [tn, jf, qbt, s, r, js, pve, adg, wz] = await Promise.all([
        fetchJson('/api/truenas').catch(() => null),
        fetchJson('/api/jellyfin').catch(() => null),
        fetchJson('/api/qbittorrent').catch(() => null),
        fetchJson('/api/sonarr').catch(() => null),
        fetchJson('/api/radarr').catch(() => null),
        fetchJson('/api/jellyseerr').catch(() => null),
        fetchJson('/api/proxmox').catch(() => null),
        fetchJson('/api/adguard').catch(() => null),
        fetchJson('/api/wazuh').catch(() => null),
      ]);

      // 1. Update TrueNAS Telemetry
      if (tn) {
        // Header Cooler Temp
        const headerFridge = document.getElementById('header-fridge-temp');
        if (headerFridge && tn.cpuTempC) {
          headerFridge.textContent = `${tn.cpuTempC.toFixed(1)}°C // ${tn.cpuTempF.toFixed(1)}°F`;
        }

        // TrueNAS Die Temp
        const dieTemp = document.getElementById('tn-die-temp');
        if (dieTemp && tn.cpuTempC) {
          dieTemp.textContent = `${tn.cpuTempC.toFixed(1)}°C // ${tn.cpuTempF.toFixed(1)}°F`;
        }

        // TrueNAS CPU
        const cpuEl = document.getElementById('tn-cpu-usage');
        if (cpuEl && tn.cpuUsage) cpuEl.textContent = tn.cpuUsage;

        // TrueNAS RAM
        const ramEl = document.getElementById('tn-ram-usage');
        if (ramEl && tn.memoryUsed) {
          ramEl.textContent = `${tn.memoryUsed || '68.0 GiB'} / ${tn.memoryTotal || '256.0 GiB'}`;
        }
        const ramBar = document.getElementById('tn-ram-bar');
        if (ramBar && tn.memoryUsageNum) {
          ramBar.style.width = `${tn.memoryUsageNum}%`;
        }

        // ARC Cache
        const arcEl = document.getElementById('tn-arc');
        if (arcEl && tn.memoryZfsCache) arcEl.textContent = tn.memoryZfsCache;

        // Pools
        if (tn.pools && Array.isArray(tn.pools)) {
          for (const pool of tn.pools) {
            if (pool.name === 'Vault') {
              const u = document.getElementById('vault-used');
              const p = document.getElementById('vault-pct');
              const b = document.getElementById('vault-bar');
              if (u) u.textContent = pool.used;
              if (p) p.textContent = pool.usedPercentage;
              if (b) b.style.width = pool.usedPercentage;
            } else if (pool.name === 'Library') {
              const u = document.getElementById('lib-used');
              const p = document.getElementById('lib-pct');
              const b = document.getElementById('lib-bar');
              if (u) u.textContent = pool.used;
              if (p) p.textContent = pool.usedPercentage;
              if (b) b.style.width = pool.usedPercentage;
            } else if (pool.name === 'SSD-Locker') {
              const u = document.getElementById('ssd-used');
              const p = document.getElementById('ssd-pct');
              const b = document.getElementById('ssd-bar');
              if (u) u.textContent = pool.used;
              if (p) p.textContent = pool.usedPercentage;
              if (b) b.style.width = pool.usedPercentage;
            }
          }
        }
      }

      // 2. Update Jellyfin Activity
      if (jf) {
        const mEl = document.getElementById('jf-movies-count');
        const sEl = document.getElementById('jf-series-count');
        const eEl = document.getElementById('jf-episodes-count');
        const badge = document.getElementById('jf-active-badge');
        const list = document.getElementById('jf-viewers-list');

        if (mEl && jf.movieCount) mEl.textContent = jf.movieCount.toLocaleString();
        if (sEl && jf.seriesCount) sEl.textContent = jf.seriesCount.toLocaleString();
        if (eEl && jf.episodeCount) eEl.textContent = jf.episodeCount.toLocaleString();
        if (badge && jf.activeStreams !== undefined) {
          badge.textContent = `${jf.activeStreams} Active Stream${jf.activeStreams === 1 ? '' : 's'}`;
        }

        if (list && jf.viewers && Array.isArray(jf.viewers)) {
          if (jf.viewers.length === 0) {
            list.innerHTML = `<div class="p-3 rounded-xl bg-black/40 border border-white/5 text-slate-500 text-center">No active streams at the moment</div>`;
          } else {
            list.innerHTML = jf.viewers.map((v: any) => `
              <div class="p-3 rounded-xl bg-black/40 border border-white/5 flex items-center justify-between">
                <div class="space-y-0.5">
                  <div class="flex items-center gap-2">
                    <span class="text-indigo-400 font-bold">${escapeHtml(v.user || 'User')}</span>
                    <span class="text-[10px] px-1.5 py-0.2 rounded bg-indigo-500/20 text-indigo-300">${escapeHtml(v.type || 'DirectPlay')}</span>
                  </div>
                  <p class="text-slate-200 font-semibold">${escapeHtml(v.content || 'Streaming Content')}</p>
                  <p class="text-[10px] text-slate-500">${escapeHtml(v.client || 'Client')} • ${escapeHtml(v.deviceName || 'Device')}</p>
                </div>
                <span class="text-emerald-400 text-xs animate-pulse font-mono">PLAYING ▶</span>
              </div>
            `).join('');
          }
        }
      }

      // 3. Update qBittorrent Activity
      if (qbt) {
        const dEl = document.getElementById('qbt-down-speed');
        const uEl = document.getElementById('qbt-up-speed');
        const tEl = document.getElementById('qbt-total-count');
        const list = document.getElementById('qbt-torrents-list');

        const fmt = (bytes: number) => {
          if (!bytes || bytes === 0) return '0 B/s';
          const k = 1024;
          const sizes = ['B/s', 'KB/s', 'MB/s', 'GB/s'];
          const i = Math.floor(Math.log(bytes) / Math.log(k));
          return `${(bytes / Math.pow(k, i)).toFixed(1)} ${sizes[i]}`;
        };

        if (dEl && qbt.downloadSpeed !== undefined) dEl.textContent = fmt(qbt.downloadSpeed);
        if (uEl && qbt.uploadSpeed !== undefined) uEl.textContent = fmt(qbt.uploadSpeed);
        if (tEl && qbt.torrentCount !== undefined) tEl.textContent = `${qbt.torrentCount} Active`;

        if (list && qbt.activeTorrents && Array.isArray(qbt.activeTorrents)) {
          list.innerHTML = qbt.activeTorrents.map((t: any) => {
            const isDown = t.state === 'downloading' || (t.progress && t.progress !== '100.0%');
            const stateClass = isDown ? 'text-cyan-400 bg-cyan-500/15' : 'text-emerald-400 bg-emerald-500/15';
            const barClass = isDown ? 'bg-cyan-400' : 'bg-emerald-400';
            const stateLabel = isDown ? 'DOWNLOADING' : 'SEEDING';
            const speedText = isDown ? `↓ ${fmt(t.dlspeed)}` : `↑ ${fmt(t.upspeed)}`;
            const safeName = escapeHtml(t.name);
            const pctNum = Math.max(0, Math.min(100, parseFloat(String(t.progress ?? '100')) || 100));
            const safeProgress = `${pctNum.toFixed(1)}%`;
            return `
              <div class="p-2.5 rounded-xl bg-black/40 border border-white/5 space-y-1">
                <div class="flex justify-between items-center text-slate-300 font-medium truncate">
                  <span class="truncate max-w-[280px]" title="${safeName}">${safeName}</span>
                  <span class="${stateClass} text-[10px] px-1.5 py-0.2 rounded">${stateLabel}</span>
                </div>
                <div class="w-full bg-white/10 rounded-full h-1.5 overflow-hidden">
                  <div class="${barClass} h-1.5 rounded-full" style="width: ${safeProgress};"></div>
                </div>
                <div class="flex justify-between text-[10px] text-slate-500">
                  <span>${safeProgress}</span>
                  <span>${escapeHtml(speedText)}</span>
                </div>
              </div>
            `;
          }).join('');
        }
      }

      // 4. Update Arr Stack (Sonarr, Radarr, Seerr)
      if (s) {
        const sEl = document.getElementById('sonarr-series');
        const qEl = document.getElementById('sonarr-queue');
        if (sEl && s.seriesCount) sEl.textContent = `${s.seriesCount} Monitored`;
        if (qEl && s.queueCount !== undefined) qEl.textContent = `${s.queueCount} Active`;
      }

      if (r) {
        const mEl = document.getElementById('radarr-movies');
        const qEl = document.getElementById('radarr-queue');
        if (mEl && r.movieCount) mEl.textContent = `${r.movieCount} Films`;
        if (qEl && r.queueCount !== undefined) qEl.textContent = `${r.queueCount} Active`;
      }

      if (js) {
        const pEl = document.getElementById('seerr-pending');
        const aEl = document.getElementById('seerr-approved');
        if (pEl && js.pendingRequests !== undefined) pEl.textContent = `${js.pendingRequests} Requests`;
        if (aEl && js.approvedRequests !== undefined) aEl.textContent = `${js.approvedRequests} Done`;
      }

      // 5. Update Proxmox & AdGuard
      if (pve) {
        const cpuEl = document.getElementById('pve-cpu-val');
        const ramEl = document.getElementById('pve-ram-val');
        if (cpuEl && pve.cpuUsage) cpuEl.textContent = pve.cpuUsage;
        if (ramEl && pve.memoryUsed) ramEl.textContent = `${pve.memoryUsed} / ${pve.memoryTotal}`;
      }

      if (adg) {
        const qEl = document.getElementById('adg-queries');
        const bEl = document.getElementById('adg-blocked');
        const rEl = document.getElementById('adg-ratio');
        const lEl = document.getElementById('adg-latency');
        if (qEl && adg.dnsQueries) qEl.textContent = adg.dnsQueries.toLocaleString();
        if (bEl && adg.blockedQueries) bEl.textContent = adg.blockedQueries.toLocaleString();
        if (rEl && adg.blockRate) rEl.textContent = adg.blockRate;
        if (lEl && adg.avgProcessingTime) lEl.textContent = adg.avgProcessingTime;
      }

      // 6. Update Wazuh SIEM & Edge Ingress Top IPs
      if (wz) {
        const totalEl = document.getElementById('wz-total-requests');
        const uniqueEl = document.getElementById('wz-unique-ips');
        const bansEl = document.getElementById('wz-active-bans');
        const topIpsList = document.getElementById('wz-top-ips-list');
        const alertsList = document.getElementById('wz-alerts-list');

        if (totalEl && wz.totalRequests) totalEl.textContent = Number(wz.totalRequests).toLocaleString();
        if (uniqueEl && wz.uniqueIps) uniqueEl.textContent = Number(wz.uniqueIps).toLocaleString();
        if (bansEl && wz.activeBans !== undefined) bansEl.textContent = `${wz.activeBans} Banned`;

        if (topIpsList && Array.isArray(wz.topIps) && wz.topIps.length > 0) {
          const maxReq = Math.max(...wz.topIps.map((item: any) => Number(item.requests) || 1), 1);
          topIpsList.innerHTML = wz.topIps.slice(0, 6).map((item: any) => {
            const reqNum = Number(item.requests) || 0;
            const pct = Math.max(4, Math.min(100, (reqNum / maxReq) * 100)).toFixed(1);
            const statusStr = String(item.status || '200');
            const isWarn = statusStr.includes('404') || statusStr.includes('444') || statusStr.includes('403');
            const statusColor = isWarn ? 'text-amber-400' : statusStr.includes('101') ? 'text-cyan-400' : 'text-emerald-400';
            const barGrad = isWarn ? 'from-amber-500 to-rose-500' : 'from-indigo-500 to-purple-500';
            return `
              <div class="p-2.5 rounded-xl bg-black/40 border border-white/5">
                <div class="flex items-center justify-between mb-1">
                  <div class="flex items-center gap-2">
                    <span class="text-white font-bold">${escapeHtml(item.ip)}</span>
                    <span class="text-[10px] px-1.5 py-0.2 rounded bg-purple-500/20 text-purple-300">${escapeHtml(item.target)}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-[10px] ${statusColor}">${escapeHtml(statusStr)}</span>
                    <span class="text-indigo-300 font-bold">${reqNum.toLocaleString()} reqs</span>
                  </div>
                </div>
                <div class="w-full bg-white/10 rounded-full h-1.5 overflow-hidden">
                  <div class="bg-gradient-to-r ${barGrad} h-1.5 rounded-full" style="width: ${pct}%;"></div>
                </div>
              </div>
            `;
          }).join('');
        }

        if (alertsList && Array.isArray(wz.securityAlerts) && wz.securityAlerts.length > 0) {
          alertsList.innerHTML = wz.securityAlerts.slice(0, 6).map((a: any) => `
            <div class="p-2.5 rounded-xl bg-black/40 border border-rose-500/20 flex items-center justify-between">
              <div class="space-y-0.5">
                <div class="flex items-center gap-2">
                  <span class="text-rose-300 font-bold">${escapeHtml(a.ip)}</span>
                  <span class="text-[10px] px-1.5 py-0.2 rounded bg-white/10 text-slate-300">${escapeHtml(a.country)} • ${escapeHtml(a.asn)}</span>
                </div>
                <p class="text-[11px] text-slate-400">Rule: <span class="text-amber-300">${escapeHtml(a.rule)}</span></p>
              </div>
              <span class="text-[10px] px-2 py-0.5 rounded bg-rose-500/20 text-rose-400 border border-rose-500/30 font-bold">${escapeHtml(a.action || 'BANNED')}</span>
            </div>
          `).join('');
        }
      }

    } catch (err) {
      console.warn('Telemetry polling error:', err);
    } finally {
      setTimeout(() => {
        if (spinner) spinner.classList.remove('animate-spin');
        if (label) label.textContent = 'Refresh';
      }, 400);
    }
  }

  function setupInterval(ms: number) {
    if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
    if (ms > 0) {
      pollTimer = setInterval(() => {
        if (!document.hidden) {
          updateTelemetry();
        }
      }, ms);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateTelemetry();

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) {
        updateTelemetry();
      }
    });

    document.getElementById('refresh-all-btn')?.addEventListener('click', () => {
      updateTelemetry();
    });

    const intervalSelect = document.getElementById('poll-interval') as HTMLSelectElement;
    if (intervalSelect) {
      setupInterval(parseInt(intervalSelect.value, 10));
      intervalSelect.addEventListener('change', () => {
        setupInterval(parseInt(intervalSelect.value, 10));
      });
    }
  });
</script>
