---
import Layout from '../layouts/Layout.astro';
import PizzaShopScene from '../components/pizza/PizzaShopScene.astro';
import PizzaHUD from '../components/pizza/PizzaHUD.astro';
import PizzaModals from '../components/pizza/PizzaModals.astro';
---

<Layout 
  title="Mikey's Pizzeria & Homelab | Michael Chavez"
  description="Interactive 3D Artisanal Pizza Parlor & Infrastructure Portfolio of Michael Chavez. Systems Administrator, Data Center Operations, and Homelab Architect."
>
  <main class="fixed inset-0 w-full h-full overflow-hidden bg-[#120c0a] select-none">
    <!-- 3D WebGL Canvas Scene -->
    <PizzaShopScene />

    <!-- Interactive Floating HUD, Preloader, and Audio Controls -->
    <PizzaHUD />

    <!-- Station Detail Modals (Oven/Projects, Menu/Resume, Arcade/Homelab, Register/Contact) -->
    <PizzaModals />
  </main>
</Layout>

<style is:global>
  /* Custom scrollbars for modal drawers */
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.35);
  }
</style>
