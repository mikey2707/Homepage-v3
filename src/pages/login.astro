---
import Layout from '../layouts/Layout.astro';
import TearableClothLogin from '../components/TearableClothLogin.astro';
import { isAuthenticated } from '../lib/auth';

// If already authenticated, go straight to the homelab dashboard
if (isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/dashboard');
}

// Always land on /dashboard after login (never bounce to / or legacy /services)
const requested = Astro.url.searchParams.get('redirect');
const redirectUrl = requested && requested.startsWith('/dashboard') ? requested : '/dashboard';
---

<Layout title="Nonna Rosa's 1924 Sourdough Codex - Mikey's Pizzeria">
  <main class="fixed inset-0 w-screen h-screen overflow-hidden bg-[#0c0907] select-none">
    <!-- Complete Full-Page Tearable Sourdough Codex & Concealed Secret Terminal -->
    <TearableClothLogin redirectUrl={redirectUrl} />
  </main>
</Layout>
