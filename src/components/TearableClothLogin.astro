---
interface Props {
  redirectUrl?: string;
  class?: string;
}

const { redirectUrl = '/dashboard', class: className = '' } = Astro.props;
---

<div class={`fixed inset-0 w-full h-full overflow-hidden bg-[#0c0907] ${className} select-none`}>

  <!-- 1. UNDERLYING SECRET ADMINISTRATIVE MAINFRAME TERMINAL -->
  <div id="underlying-login-terminal" class="fixed inset-0 flex items-center justify-center p-3 sm:p-6 z-10 pointer-events-auto bg-[#0a080d] overflow-y-auto">
    <!-- Ambient glow & grid backdrop -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-electric-iris/20 via-black to-[#060408] pointer-events-none"></div>
    <div class="absolute inset-0 opacity-15 pointer-events-none" style="background-size: 32px 32px; background-image: linear-gradient(to right, rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.06) 1px, transparent 1px);"></div>

    <!-- Terminal Gateway Card -->
    <div class="relative w-full max-w-lg my-auto p-5 sm:p-8 rounded-3xl bg-[#110e17]/95 border border-electric-iris/40 shadow-[0_0_70px_rgba(128,82,255,0.3)] backdrop-blur-2xl text-left z-20">
      <!-- Terminal Window Bar -->
      <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/10">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-rose-500/90 shadow-sm shadow-rose-500/50"></span>
          <span class="w-3 h-3 rounded-full bg-saffron-spark/90 shadow-sm shadow-saffron-spark/50"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/90 shadow-sm shadow-emerald-500/50"></span>
          <span class="ml-2 font-mono text-[11px] text-ash-gray uppercase tracking-widest">~/mikey/homelab/master-gate</span>
        </div>
        <span class="text-[10px] font-mono font-bold px-2.5 py-0.5 rounded-full bg-electric-iris/20 text-electric-iris border border-electric-iris/40">
          TLS 1.3 // 256-BIT
        </span>
      </div>

      <!-- Header -->
      <div class="mb-6">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-[10px] font-mono uppercase tracking-wider mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Core Cluster Online • 14 Nodes</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-normal tracking-monolithic text-cream mb-1">
          Private Homelab Gateway
        </h2>
        <p class="text-xs text-ash-gray font-light leading-relaxed">
          Beneath the 100-year sourdough starter lies the private homelab mainframe. Enter master credentials to access deep virtualization, telemetry, and service controls.
        </p>
      </div>

      <!-- Alert / Error message -->
      <div id="tear-login-error" class="hidden mb-4 p-3.5 rounded-2xl bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs font-mono"></div>

      <!-- Login Form -->
      <form id="tear-login-form" class="space-y-4">
        <input type="hidden" name="redirect" value={redirectUrl} />

        <div>
          <label for="tear-username" class="block text-xs font-medium uppercase tracking-label text-ash-gray mb-1.5">
            Admin Identity
          </label>
          <input
            type="text"
            id="tear-username"
            name="username"
            required
            autocomplete="username"
            placeholder="Username"
            class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/10 text-white placeholder-white/20 text-sm focus:outline-none focus:border-electric-iris focus:ring-1 focus:ring-electric-iris transition-colors font-mono"
          />
        </div>

        <div>
          <label for="tear-password" class="block text-xs font-medium uppercase tracking-label text-ash-gray mb-1.5">
            Master Passphrase
          </label>
          <input
            type="password"
            id="tear-password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="••••••••••••"
            class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/10 text-white placeholder-white/20 text-sm focus:outline-none focus:border-electric-iris focus:ring-1 focus:ring-electric-iris transition-colors font-mono"
          />
        </div>

        <button
          type="submit"
          id="tear-login-btn"
          class="w-full mt-2 py-3.5 px-6 rounded-full font-medium text-sm text-white bg-gradient-to-r from-electric-iris to-purple-600 hover:opacity-95 shadow-lg shadow-electric-iris/30 transition-all duration-200 hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer font-mono font-bold"
        >
          <span id="tear-btn-text">AUTHENTICATE & UNLOCK MAINFRAME</span>
          <svg id="tear-btn-spinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>

      <div class="mt-6 pt-4 border-t border-white/10 text-center">
        <a href="/" class="text-xs font-mono text-ash-gray hover:text-white transition-colors">
          ← Return to Pizzeria Overview
        </a>
      </div>
    </div>
  </div>

  <!-- 2. OVERLYING 3D WEBGL + WASM TEARABLE CLOTH CANVAS (pushmatrix/tearable engine) -->
  <canvas
    id="tearable-cloth-canvas"
    class="fixed inset-0 w-full h-full z-20 cursor-grab active:cursor-grabbing touch-none select-none"
  ></canvas>

  <!-- 3. TOP BACK BUTTON (Innocent return to pizzeria) -->
  <div class="fixed top-4 left-4 sm:left-8 z-30 pointer-events-none">
    <a
      href="/"
      class="pointer-events-auto px-4 py-2 rounded-2xl bg-black/80 hover:bg-black text-xs font-mono text-cream border border-amber-500/30 backdrop-blur-xl shadow-2xl transition-all flex items-center gap-2 hover:scale-105 active:scale-95"
      title="Return to 3D Pizzeria"
    >
      <span>🍕</span>
      <span>← Back to Pizzeria</span>
    </a>
  </div>

</div>

<script>
  import * as THREE from 'three';

  const isTouch =
    typeof window !== 'undefined' &&
    ('ontouchstart' in window || navigator.maxTouchPoints > 0);

  // Exact physics & mesh configuration from pushmatrix/tearable
  const CLOTH_CFG = {
    gridWidth: isTouch ? 40 : 100,
    gridHeight: isTouch ? 40 : 100,
    damping: 0.97,
    gravity: { x: 0, y: isTouch ? -0.0006 : -0.0003, z: 0 },
    constraintIterations: isTouch ? 1 : 2,
    subSteps: 1,
    stiffness: 0.25,
    tearThreshold: isTouch ? 4.1 : 5.5,
    mouseRadius: isTouch ? 0.2 : 0.4,
    mouseStrength: isTouch ? 0.72 : 0.6,
    cutRadius: 0.05,
    dropTearPercent: isTouch ? 5.5 : 4.5,
  };

  class WebGLTearableCloth {
    canvas: HTMLCanvasElement;
    renderer: THREE.WebGLRenderer;
    scene: THREE.Scene;
    camera: THREE.OrthographicCamera;
    mesh!: THREE.Mesh;
    geometry!: THREE.BufferGeometry;
    material!: THREE.Material;
    parchmentTexture!: THREE.CanvasTexture;

    worker: Worker;
    instanceId = 1;
    width = 0;
    height = 0;
    worldWidth = 2;
    worldHeight = 2;
    particleCount = 0;
    constraintCount = 1;
    brokenCount = 0;
    drawCount = 0;
    posArray!: Float32Array;
    normalsArray!: Float32Array;
    indexArray!: Uint32Array;
    transitBuffer: ArrayBuffer | null = null;
    inFlight = false;

    isDragging = false;
    dragButton = 0;
    hasInteracted = false;
    dropped = false;
    destroyed = false;
    curWorld = { x: 0, y: 0, z: 0 };
    prevWorld = { x: 0, y: 0, z: 0 };
    activeTouches = new Map<number, { slot: number; x: number; y: number; z: number }>();
    slotUsed = new Array(8).fill(false);

    lastFrameTime = performance.now();
    rafId: number | null = null;
    onDropped?: () => void;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.width = window.innerWidth;
      this.height = window.innerHeight;

      this.renderer = new THREE.WebGLRenderer({
        canvas: this.canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance',
      });
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      this.renderer.setSize(this.width, this.height, false);
      this.renderer.outputColorSpace = THREE.SRGBColorSpace;

      this.scene = new THREE.Scene();

      const aspect = this.width / this.height;
      this.camera = new THREE.OrthographicCamera(
        aspect > 1 ? -aspect : -1,
        aspect > 1 ? aspect : 1,
        aspect > 1 ? 1 : 1 / aspect,
        aspect > 1 ? -1 : -1 / aspect,
        0.1,
        100
      );
      this.camera.position.set(0, 0, 5);

      // 3D Lighting identical to pushmatrix/tearable for realistic cloth fold shading
      const ambient = new THREE.AmbientLight(0xffffff, 1.5);
      this.scene.add(ambient);

      const dirLight1 = new THREE.DirectionalLight(0xffffff, 0.4);
      dirLight1.position.set(0.3, 0.3, 5);
      this.scene.add(dirLight1);

      const dirLight2 = new THREE.DirectionalLight(0xffffff, 1.2);
      dirLight2.position.set(0, 5, 4);
      this.scene.add(dirLight2);

      this.worker = new Worker('/cloth.worker.js');
      this.worker.onmessage = (e) => this.onWorkerMessage(e.data);

      this.initClothMesh();
      this.bindEvents();
      this.lastFrameTime = performance.now();
      this.rafId = requestAnimationFrame(this.animate);
    }

    initClothMesh() {
      this.width = window.innerWidth;
      this.height = window.innerHeight;
      const aspect = this.width / this.height;

      this.camera.left = aspect > 1 ? -aspect : -1;
      this.camera.right = aspect > 1 ? aspect : 1;
      this.camera.top = aspect > 1 ? 1 : 1 / aspect;
      this.camera.bottom = aspect > 1 ? -1 : -1 / aspect;
      this.camera.updateProjectionMatrix();
      this.renderer.setSize(this.width, this.height, false);

      this.worldWidth = aspect > 1 ? aspect * 2 : 2;
      this.worldHeight = aspect > 1 ? 2 : 2 / aspect;

      const segX = CLOTH_CFG.gridWidth;
      const segY = CLOTH_CFG.gridHeight;
      const count = (segX + 1) * (segY + 1);
      this.particleCount = count;

      this.posArray = new Float32Array(count * 3);
      this.normalsArray = new Float32Array(count * 3);
      const uvs = new Float32Array(count * 2);
      const colors = new Float32Array(count * 3);
      colors.fill(1);

      const dx = this.worldWidth / segX;
      const dy = this.worldHeight / segY;
      const halfW = this.worldWidth / 2;
      const halfH = this.worldHeight / 2;
      const stride = segX + 1;

      for (let r = 0; r <= segY; r++) {
        for (let c = 0; c <= segX; c++) {
          const idx = r * stride + c;
          const pIdx = idx * 3;
          this.posArray[pIdx] = c * dx - halfW;
          this.posArray[pIdx + 1] = halfH - r * dy;
          this.posArray[pIdx + 2] = 0;

          this.normalsArray[pIdx] = 0;
          this.normalsArray[pIdx + 1] = 0;
          this.normalsArray[pIdx + 2] = 1;

          const uIdx = idx * 2;
          uvs[uIdx] = c / segX;
          uvs[uIdx + 1] = 1 - r / segY;
        }
      }

      this.indexArray = new Uint32Array(segX * segY * 6);
      let ptr = 0;
      for (let r = 0; r < segY; r++) {
        for (let c = 0; c < segX; c++) {
          const i0 = c + stride * r;
          const i1 = c + stride * (r + 1);
          const i2 = c + 1 + stride * (r + 1);
          const i3 = c + 1 + stride * r;
          this.indexArray[ptr++] = i0;
          this.indexArray[ptr++] = i1;
          this.indexArray[ptr++] = i3;
          this.indexArray[ptr++] = i1;
          this.indexArray[ptr++] = i2;
          this.indexArray[ptr++] = i3;
        }
      }
      this.drawCount = ptr;

      if (this.mesh) {
        this.scene.remove(this.mesh);
        this.geometry.dispose();
        this.material.dispose();
        if (this.parchmentTexture) this.parchmentTexture.dispose();
      }

      this.geometry = new THREE.BufferGeometry();
      const posAttr = new THREE.BufferAttribute(this.posArray, 3);
      posAttr.setUsage(THREE.DynamicDrawUsage);
      const normAttr = new THREE.BufferAttribute(this.normalsArray, 3);
      normAttr.setUsage(THREE.DynamicDrawUsage);
      const indexAttr = new THREE.BufferAttribute(this.indexArray, 1);
      indexAttr.setUsage(THREE.DynamicDrawUsage);

      this.geometry.setAttribute('position', posAttr);
      this.geometry.setAttribute('normal', normAttr);
      this.geometry.setAttribute('uv', new THREE.BufferAttribute(uvs, 2));
      this.geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
      this.geometry.setIndex(indexAttr);
      this.geometry.setDrawRange(0, this.drawCount);

      const texCanvas = this.createParchmentCanvas(this.width, this.height);
      this.parchmentTexture = new THREE.CanvasTexture(texCanvas);
      this.parchmentTexture.colorSpace = THREE.SRGBColorSpace;
      this.parchmentTexture.minFilter = THREE.LinearFilter;
      this.parchmentTexture.magFilter = THREE.LinearFilter;

      this.material = isTouch
        ? new THREE.MeshLambertMaterial({
            map: this.parchmentTexture,
            color: 0xffffff,
            side: THREE.DoubleSide,
            vertexColors: true,
          })
        : new THREE.MeshStandardMaterial({
            map: this.parchmentTexture,
            color: 0xffffff,
            side: THREE.DoubleSide,
            roughness: 0.92,
            metalness: 0.08,
            vertexColors: true,
          });

      this.mesh = new THREE.Mesh(this.geometry, this.material);
      this.scene.add(this.mesh);

      this.instanceId++;
      this.inFlight = false;
      this.transitBuffer = null;
      this.brokenCount = 0;

      this.worker.postMessage({
        type: 'init',
        id: this.instanceId,
        width: this.worldWidth,
        height: this.worldHeight,
        segX,
        segY,
        tearThreshold: CLOTH_CFG.tearThreshold,
        stiffness: CLOTH_CFG.stiffness,
      });

      this.renderer.render(this.scene, this.camera);
    }

    onWorkerMessage(msg: any) {
      if (this.destroyed || msg.id !== this.instanceId) return;

      if (msg.type === 'ready') {
        this.constraintCount = msg.constraintCount || 1;
        return;
      }

      if (msg.type === 'stepResult') {
        const nextPos = new Float32Array(msg.buffer);
        if (nextPos.length === this.posArray.length) {
          this.posArray.set(nextPos);
          (this.geometry.attributes.position as THREE.BufferAttribute).needsUpdate = true;
        }
        this.transitBuffer = msg.buffer;

        if (msg.normals) {
          const nextNorm = new Float32Array(msg.normals);
          if (nextNorm.length === this.normalsArray.length) {
            this.normalsArray.set(nextNorm);
            (this.geometry.attributes.normal as THREE.BufferAttribute).needsUpdate = true;
          }
        }

        if (msg.index) {
          const nextIdx = new Uint32Array(msg.index);
          const count = Math.min(nextIdx.length, this.indexArray.length);
          this.indexArray.set(nextIdx.subarray(0, count));
          this.drawCount = count;
          this.geometry.setDrawRange(0, count);
          if (this.geometry.index) {
            this.geometry.index.needsUpdate = true;
          }
        }

        this.brokenCount = msg.brokenCount || 0;
        this.inFlight = false;

        // Check tear percentage threshold (identical to pushmatrix/tearable z4 threshold)
        const tearPct = (this.brokenCount / this.constraintCount) * 100;
        if (!this.dropped && tearPct >= CLOTH_CFG.dropTearPercent) {
          this.triggerDrop();
        }
      }
    }

    triggerDrop() {
      if (this.dropped) return;
      this.dropped = true;
      this.worker.postMessage({ type: 'drop', id: this.instanceId });
      if (this.onDropped) {
        this.onDropped();
      }
    }

    screenToWorld(clientX: number, clientY: number) {
      const ndcX = (clientX / this.width) * 2 - 1;
      const ndcY = -(clientY / this.height) * 2 + 1;
      return {
        x: ndcX * (this.worldWidth * 0.5),
        y: ndcY * (this.worldHeight * 0.5),
        z: 0,
      };
    }

    allocSlot(): number {
      for (let i = 0; i < this.slotUsed.length; i++) {
        if (!this.slotUsed[i]) {
          this.slotUsed[i] = true;
          return i;
        }
      }
      return -1;
    }

    freeSlot(slot: number) {
      if (slot >= 0 && slot < this.slotUsed.length) {
        this.slotUsed[slot] = false;
      }
    }

    bindEvents() {
      this.canvas.addEventListener('contextmenu', (e) => e.preventDefault());

      this.canvas.addEventListener('mousedown', (e) => {
        if (this.dropped) return;
        e.preventDefault();
        this.hasInteracted = true;
        this.isDragging = true;
        this.dragButton = e.button ?? 0;

        const pt = this.screenToWorld(e.clientX, e.clientY);
        this.curWorld = { ...pt };
        this.prevWorld = { ...pt };

        if (this.dragButton === 0) {
          this.worker.postMessage({
            type: 'grab',
            id: this.instanceId,
            slot: 0,
            x: pt.x,
            y: pt.y,
            z: pt.z,
            radius: CLOTH_CFG.mouseRadius,
          });
        }
      });

      window.addEventListener('mousemove', (e) => {
        if (!this.isDragging || this.dropped) return;
        this.prevWorld = { ...this.curWorld };
        this.curWorld = this.screenToWorld(e.clientX, e.clientY);

        if (this.dragButton === 2) {
          this.worker.postMessage({
            type: 'cut',
            id: this.instanceId,
            mx: this.curWorld.x,
            my: this.curWorld.y,
            mz: this.curWorld.z,
            px: this.prevWorld.x,
            py: this.prevWorld.y,
            radius: CLOTH_CFG.cutRadius,
          });
        } else {
          this.worker.postMessage({
            type: 'moveGrab',
            id: this.instanceId,
            slot: 0,
            x: this.curWorld.x,
            y: this.curWorld.y,
            strength: CLOTH_CFG.mouseStrength,
          });
        }
      });

      const endMouseDrag = () => {
        if (!this.isDragging) return;
        this.isDragging = false;
        this.worker.postMessage({
          type: 'releaseGrab',
          id: this.instanceId,
        });
      };

      window.addEventListener('mouseup', endMouseDrag);
      window.addEventListener('mouseleave', endMouseDrag);

      this.canvas.addEventListener(
        'touchstart',
        (e) => {
          if (this.dropped) return;
          e.preventDefault();
          this.hasInteracted = true;
          for (let i = 0; i < e.changedTouches.length; i++) {
            const t = e.changedTouches[i];
            if (this.activeTouches.has(t.identifier)) continue;
            const slot = this.allocSlot();
            if (slot < 0) continue;
            const pt = this.screenToWorld(t.clientX, t.clientY);
            this.activeTouches.set(t.identifier, { slot, ...pt });
            this.worker.postMessage({
              type: 'grab',
              id: this.instanceId,
              slot,
              x: pt.x,
              y: pt.y,
              z: pt.z,
              radius: CLOTH_CFG.mouseRadius,
            });
          }
        },
        { passive: false }
      );

      window.addEventListener(
        'touchmove',
        (e) => {
          if (this.dropped || this.activeTouches.size === 0) return;
          e.preventDefault();
          for (let i = 0; i < e.changedTouches.length; i++) {
            const t = e.changedTouches[i];
            const info = this.activeTouches.get(t.identifier);
            if (!info) continue;
            const pt = this.screenToWorld(t.clientX, t.clientY);
            info.x = pt.x;
            info.y = pt.y;
            info.z = pt.z;
            this.worker.postMessage({
              type: 'moveGrab',
              id: this.instanceId,
              slot: info.slot,
              x: pt.x,
              y: pt.y,
              strength: CLOTH_CFG.mouseStrength,
            });
          }
        },
        { passive: false }
      );

      const endTouches = (e: TouchEvent) => {
        for (let i = 0; i < e.changedTouches.length; i++) {
          const t = e.changedTouches[i];
          const info = this.activeTouches.get(t.identifier);
          if (info) {
            this.activeTouches.delete(t.identifier);
            this.freeSlot(info.slot);
            this.worker.postMessage({
              type: 'releaseGrab',
              id: this.instanceId,
              slot: info.slot,
            });
          }
        }
      };

      window.addEventListener('touchend', endTouches);
      window.addEventListener('touchcancel', endTouches);

      let resizeTimer: any = null;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          if (!this.dropped && !this.destroyed) {
            this.initClothMesh();
          }
        }, 150);
      });
    }

    animate = (now: number) => {
      if (this.destroyed) {
        this.rafId = null;
        return;
      }

      const dtSec = Math.min(0.05, Math.max(0.001, (now - this.lastFrameTime) / 1000));
      this.lastFrameTime = now;

      const isIdle = !this.hasInteracted && !this.dropped && this.brokenCount === 0 && !this.isDragging;
      if (!isIdle && !this.inFlight) {
        if (!this.dropped && this.isDragging && this.dragButton === 0) {
          this.worker.postMessage({
            type: 'moveGrab',
            id: this.instanceId,
            slot: 0,
            x: this.curWorld.x,
            y: this.curWorld.y,
            strength: CLOTH_CFG.mouseStrength,
          });
        }

        if (!this.dropped && this.activeTouches.size > 0) {
          for (const [, info] of this.activeTouches) {
            this.worker.postMessage({
              type: 'moveGrab',
              id: this.instanceId,
              slot: info.slot,
              x: info.x,
              y: info.y,
              strength: CLOTH_CFG.mouseStrength,
            });
          }
        }

        const timeScale = Math.min(3, Math.max(0.5, dtSec * 60));
        const gravMult = this.dropped ? 3 : this.brokenCount > 0 ? 2.5 : 1;
        const gFactor = (gravMult * timeScale) / CLOTH_CFG.subSteps;
        const gx = CLOTH_CFG.gravity.x * gFactor;
        const gy = CLOTH_CFG.gravity.y * gFactor;
        const gz = CLOTH_CFG.gravity.z * gFactor;

        this.inFlight = true;
        const transferBuf = this.transitBuffer;
        this.transitBuffer = null;

        if (transferBuf) {
          this.worker.postMessage(
            {
              type: 'step',
              id: this.instanceId,
              gx,
              gy,
              gz,
              damping: CLOTH_CFG.damping,
              iterations: CLOTH_CFG.constraintIterations,
              subSteps: CLOTH_CFG.subSteps,
              buffer: transferBuf,
            },
            [transferBuf]
          );
        } else {
          this.worker.postMessage({
            type: 'step',
            id: this.instanceId,
            gx,
            gy,
            gz,
            damping: CLOTH_CFG.damping,
            iterations: CLOTH_CFG.constraintIterations,
            subSteps: CLOTH_CFG.subSteps,
          });
        }
      }

      this.renderer.render(this.scene, this.camera);
      this.rafId = requestAnimationFrame(this.animate);
    };

    destroy() {
      if (this.destroyed) return;
      this.destroyed = true;
      if (this.rafId !== null) {
        cancelAnimationFrame(this.rafId);
        this.rafId = null;
      }
      this.worker.postMessage({ type: 'dispose', id: this.instanceId });
      this.worker.terminate();
      this.geometry?.dispose();
      this.material?.dispose();
      this.parchmentTexture?.dispose();
      this.renderer.dispose();
    }

    // Render the authentic 1924 Sourdough Codex and Fun Facts document to an offscreen canvas
    createParchmentCanvas(width: number, height: number): HTMLCanvasElement {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const canvas = document.createElement('canvas');
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      const ctx = canvas.getContext('2d')!;
      ctx.scale(dpr, dpr);

      // 1. Aged Warm Sourdough Parchment Background
      const bgGrad = ctx.createLinearGradient(0, 0, width, height);
      bgGrad.addColorStop(0, '#fbf5ea');
      bgGrad.addColorStop(0.3, '#f5e7ce');
      bgGrad.addColorStop(0.7, '#eeddbf');
      bgGrad.addColorStop(1, '#e3cfa8');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, width, height);

      // 2. Micro paper grain & fibers
      ctx.fillStyle = 'rgba(120, 80, 40, 0.035)';
      for (let i = 0; i < 3500; i++) {
        ctx.fillRect(Math.random() * width, Math.random() * height, 2, 2);
      }

      // 3. Antique Aged Vignette around screen edges
      const edgeGrad = ctx.createRadialGradient(
        width / 2, height / 2, Math.min(width, height) * 0.35,
        width / 2, height / 2, Math.max(width, height) * 0.72
      );
      edgeGrad.addColorStop(0, 'rgba(0,0,0,0)');
      edgeGrad.addColorStop(0.8, 'rgba(150, 100, 50, 0.22)');
      edgeGrad.addColorStop(1, 'rgba(90, 50, 20, 0.55)');
      ctx.fillStyle = edgeGrad;
      ctx.fillRect(0, 0, width, height);

      // 4. Double Ornate Filigree Borders
      const margin = Math.min(36, width * 0.03);
      ctx.strokeStyle = '#8a252c'; // Tuscan wine red
      ctx.lineWidth = 5;
      ctx.strokeRect(margin, margin, width - margin * 2, height - margin * 2);

      ctx.strokeStyle = '#c59b27'; // Antique gold
      ctx.lineWidth = 2.5;
      ctx.strokeRect(margin + 10, margin + 10, width - (margin + 10) * 2, height - (margin + 10) * 2);

      // Corner heraldic flourishes
      const drawCorner = (x: number, y: number, flipX: number, flipY: number) => {
        ctx.save();
        ctx.translate(x, y);
        ctx.scale(flipX, flipY);
        ctx.strokeStyle = '#c59b27';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.moveTo(8, 36);
        ctx.quadraticCurveTo(8, 8, 36, 8);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(14, 14, 4, 0, Math.PI * 2);
        ctx.fillStyle = '#8a252c';
        ctx.fill();
        ctx.restore();
      };
      drawCorner(margin + 10, margin + 10, 1, 1);
      drawCorner(width - (margin + 10), margin + 10, -1, 1);
      drawCorner(margin + 10, height - (margin + 10), 1, -1);
      drawCorner(width - (margin + 10), height - (margin + 10), -1, -1);

      // 5. Header: Nonna Rosa's 1924 Sourdough Almanac
      const isNarrow = width < 960;
      const isVeryNarrow = width < 600;

      ctx.fillStyle = '#8a252c';
      ctx.font = `bold ${isVeryNarrow ? 10 : 12}px Georgia, serif`;
      ctx.textAlign = 'center';
      ctx.fillText('★ CASERTA, CAMPANIA • EST. 1924 ★', width / 2, margin + (isNarrow ? 26 : 38));

      ctx.fillStyle = '#2c1810';
      const trattoriaSize = Math.max(13, Math.min(22, Math.floor(width * 0.02)));
      ctx.font = `bold italic ${trattoriaSize}px "Playfair Display", Georgia, serif`;
      ctx.fillText("Nonna Rosa's Wood-Fired Trattoria & Pizzeria", width / 2, margin + (isNarrow ? 50 : 70));

      const titleSize = Math.max(12, Math.min(26, Math.floor(width * 0.024)));
      ctx.font = `900 ${titleSize}px Georgia, serif`;
      ctx.fillStyle = '#1c0e08';
      const titleText = 'THE 100-YEAR SOURDOUGH CODEX & PIZZERIA SECRETS';
      const maxTitleW = width - margin * 2 - 40;
      if (ctx.measureText(titleText).width > maxTitleW) {
        ctx.fillText('THE 100-YEAR SOURDOUGH CODEX', width / 2, margin + (isNarrow ? 72 : 98));
        ctx.fillText('& PIZZERIA SECRETS', width / 2, margin + (isNarrow ? 90 : 122));
      } else {
        ctx.fillText(titleText, width / 2, margin + (isNarrow ? 76 : 106));
      }

      ctx.fillStyle = '#b8860b';
      const specSize = Math.max(8, Math.min(11, Math.floor(width * 0.01)));
      ctx.font = `bold ${specSize}px monospace`;
      const specY = isNarrow ? margin + 112 : margin + 132;
      ctx.fillText('OFFICIAL HERITAGE SPECIFICATION • SPECIALITÀ TRADIZIONALE GARANTITA (S.T.G.)', width / 2, specY);

      // Header Divider Line
      const dividerY = specY + 12;
      ctx.strokeStyle = '#c59b27';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(margin + 20, dividerY);
      ctx.lineTo(width - (margin + 20), dividerY);
      ctx.stroke();

      // 6. Responsive Fun Fact Cards (3 Columns if wide, stacked if narrow)
      const isWide = width >= 960;
      const contentTop = dividerY + 14;
      const contentBottom = height - margin - 110;
      const availableHeight = Math.max(160, contentBottom - contentTop);

      const funFacts = [
        {
          icon: '🌾',
          title: 'The 1924 Lievito Madre',
          sub: '100-YEAR UNBROKEN MOTHER CULTURE',
          body: 'Did you know? Our wild sourdough starter was first kneaded in Caserta, Campania in October 1924. Nurtured daily with stone-milled Italian wheat and mountain spring water for a century, its wild lactobacillus culture produces immense airy steam pockets with zero commercial yeast.'
        },
        {
          icon: '🔥',
          title: '485°C Wood-Fired Physics',
          sub: 'THE 90-SECOND LEOPARD BAKE',
          body: 'Why bake in only 90 seconds? At 485°C (905°F), trapped water inside the dough vaporizes instantly into boiling steam. This balloons the rim (cornicione) in 60 to 90 seconds while woodsmoke chars blistered dark leopard spots across the crust without drying the crumb.'
        },
        {
          icon: '💧',
          title: '65% Hydration & Cold Rise',
          sub: '48-HOUR ENZYME MATURATION',
          body: 'Per 1,000g of Tipo 00 flour, exactly 650g of ice-cold mineral water and 28g of sea salt are hand-kneaded. A 48-hour cold fermentation gently digests complex starches, resulting in a crust so light and easy to digest you could eat two whole pies.'
        }
      ];

      const cardMargin = Math.max(12, margin);
      const availableW = width - cardMargin * 2 - 20;

      if (isWide) {
        const colWidth = availableW / 3;
        const cardH = Math.min(240, availableHeight - 90);
        funFacts.forEach((fact, i) => {
          const colX = cardMargin + 10 + i * colWidth;

          ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
          ctx.strokeStyle = '#c59b27';
          ctx.lineWidth = 1.2;
          ctx.fillRect(colX + 6, contentTop, colWidth - 12, cardH);
          ctx.strokeRect(colX + 6, contentTop, colWidth - 12, cardH);

          ctx.fillStyle = '#8a252c';
          ctx.font = '22px serif';
          ctx.textAlign = 'center';
          ctx.fillText(fact.icon, colX + colWidth / 2, contentTop + 32);

          ctx.fillStyle = '#1c0e08';
          ctx.font = 'bold 15px Georgia, serif';
          ctx.fillText(fact.title, colX + colWidth / 2, contentTop + 60);

          ctx.fillStyle = '#b8860b';
          ctx.font = 'bold 9px monospace';
          ctx.fillText(fact.sub, colX + colWidth / 2, contentTop + 78);

          ctx.fillStyle = '#2c1810';
          ctx.font = '12px/1.45 Georgia, serif';
          ctx.textAlign = 'left';
          this.wrapText(ctx, fact.body, colX + 18, contentTop + 102, colWidth - 36, 17);
        });
      } else {
        const cardH = Math.min(125, Math.floor((availableHeight - 80) / 2));
        funFacts.slice(0, 2).forEach((fact, i) => {
          const rowY = contentTop + i * (cardH + 8);
          ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
          ctx.strokeStyle = '#c59b27';
          ctx.lineWidth = 1;
          ctx.fillRect(cardMargin + 10, rowY, availableW, cardH);
          ctx.strokeRect(cardMargin + 10, rowY, availableW, cardH);

          ctx.fillStyle = '#1c0e08';
          ctx.font = 'bold 13px Georgia, serif';
          ctx.textAlign = 'left';
          ctx.fillText(`${fact.icon} ${fact.title}`, cardMargin + 22, rowY + 24);

          ctx.fillStyle = '#2c1810';
          ctx.font = '11px/1.35 Georgia, serif';
          this.wrapText(ctx, fact.body, cardMargin + 22, rowY + 44, availableW - 24, 15);
        });
      }

      // 7. The Baker's Secret Note (Bottom Lore)
      const noteY = isWide ? contentTop + 255 : contentTop + 265;
      if (noteY + 65 < height - margin - 35) {
        ctx.fillStyle = 'rgba(138, 37, 44, 0.08)';
        ctx.strokeStyle = '#8a252c';
        ctx.lineWidth = 1.5;
        const noteW = Math.min(760, width - margin * 2 - 20);
        const noteX = (width - noteW) / 2;
        const noteH = isVeryNarrow ? 65 : 75;
        ctx.fillRect(noteX, noteY, noteW, noteH);
        ctx.strokeRect(noteX, noteY, noteW, noteH);

        ctx.fillStyle = '#8a252c';
        ctx.font = `bold ${isVeryNarrow ? 10 : 12}px Georgia, serif`;
        ctx.textAlign = 'center';
        ctx.fillText("📜 THE BAKER'S SECRET MAIN NOTE (GRAB & PULL TO TEAR)", width / 2, noteY + 22);

        ctx.fillStyle = '#1c0e08';
        ctx.font = `italic ${isVeryNarrow ? 10 : 12}px Georgia, serif`;
        ctx.textAlign = 'center';
        this.wrapText(
          ctx,
          "“Tradition runs on fire, but in the heart of this pizzeria, an automated network keeps every degree and packet in sync. They say if you tear beneath the parchment fiber, the maestro's control mainframe is still running...”",
          width / 2,
          noteY + 42,
          noteW - 24,
          isVeryNarrow ? 13 : 16
        );
      }

      // 8. Crimson Wax Seal (Bottom Right)
      const sealScale = isVeryNarrow ? 0.7 : isNarrow ? 0.85 : 1.0;
      const sealR = 38 * sealScale;
      const sealX = width - margin - (isVeryNarrow ? 40 : 65);
      const sealY = height - margin - (isVeryNarrow ? 45 : 65);

      ctx.fillStyle = '#a82c35';
      ctx.beginPath();
      ctx.moveTo(sealX - 12 * sealScale, sealY + 15 * sealScale);
      ctx.lineTo(sealX - 20 * sealScale, sealY + 50 * sealScale);
      ctx.lineTo(sealX - 8 * sealScale, sealY + 42 * sealScale);
      ctx.lineTo(sealX + 4 * sealScale, sealY + 50 * sealScale);
      ctx.lineTo(sealX - 4 * sealScale, sealY + 15 * sealScale);
      ctx.fill();

      const waxGrad = ctx.createRadialGradient(sealX - 8, sealY - 8, 4, sealX, sealY, sealR);
      waxGrad.addColorStop(0, '#e53935');
      waxGrad.addColorStop(0.7, '#b71c1c');
      waxGrad.addColorStop(1, '#5f0909');
      ctx.fillStyle = waxGrad;
      ctx.beginPath();
      ctx.arc(sealX, sealY, sealR, 0, Math.PI * 2);
      ctx.fill();

      ctx.strokeStyle = '#ffd700';
      ctx.lineWidth = 1.8 * sealScale;
      ctx.beginPath();
      ctx.arc(sealX, sealY, sealR * 0.8, 0, Math.PI * 2);
      ctx.stroke();

      ctx.fillStyle = '#ffd700';
      ctx.font = `bold ${Math.round(11 * sealScale)}px Georgia, serif`;
      ctx.textAlign = 'center';
      ctx.fillText('1924', sealX, sealY - 5 * sealScale);
      ctx.fillText('★ NAPOLI ★', sealX, sealY + 10 * sealScale);

      // 9. Weathered Red Stamp (Bottom Left)
      const stampScale = isVeryNarrow ? 0.7 : isNarrow ? 0.85 : 1.0;
      const stampW = 180 * stampScale;
      const stampH = 44 * stampScale;
      const stampX = margin + (isVeryNarrow ? 50 : 85);
      const stampY = height - margin - (isVeryNarrow ? 45 : 65);

      ctx.save();
      ctx.translate(stampX, stampY);
      ctx.rotate(-0.12);
      ctx.strokeStyle = 'rgba(180, 40, 40, 0.75)';
      ctx.lineWidth = 3 * stampScale;
      ctx.strokeRect(-stampW / 2, -stampH / 2, stampW, stampH);
      ctx.fillStyle = 'rgba(180, 40, 40, 0.85)';
      ctx.font = `900 ${Math.round(11 * stampScale)}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText('VERIFIED TRADITIONAL', 0, -3 * stampScale);
      ctx.fillText('★ S.T.G. SPECIALITÀ ★', 0, 10 * stampScale);
      ctx.restore();

      return canvas;
    }

    wrapText(ctx: CanvasRenderingContext2D, text: string, x: number, y: number, maxWidth: number, lineHeight: number) {
      const words = text.split(' ');
      let line = '';
      let curY = y;

      for (let n = 0; n < words.length; n++) {
        const testLine = line + words[n] + ' ';
        const metrics = ctx.measureText(testLine);
        if (metrics.width > maxWidth && n > 0) {
          ctx.fillText(line, x, curY);
          line = words[n] + ' ';
          curY += lineHeight;
        } else {
          line = testLine;
        }
      }
      ctx.fillText(line, x, curY);
    }
  }

  // Initialize Component
  function initLogin() {
    const canvas = document.getElementById('tearable-cloth-canvas') as HTMLCanvasElement;
    const form = document.getElementById('tear-login-form') as HTMLFormElement;
    const errorEl = document.getElementById('tear-login-error');
    const btnText = document.getElementById('tear-btn-text');
    const btnSpinner = document.getElementById('tear-btn-spinner');
    const submitBtn = document.getElementById('tear-login-btn') as HTMLButtonElement;

    if (!canvas) return;

    const cloth = new WebGLTearableCloth(canvas);

    cloth.onDropped = () => {
      // Allow clicking/typing into the underlying terminal immediately as the 3D cloth drops
      canvas.style.pointerEvents = 'none';
      const userField = document.getElementById('tear-username');
      if (userField) userField.focus();

      setTimeout(() => {
        canvas.style.transition = 'opacity 0.5s ease';
        canvas.style.opacity = '0';
        setTimeout(() => {
          cloth.destroy();
        }, 550);
      }, 3200);
    };

    // Handle AJAX Form Submission
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorEl) errorEl.classList.add('hidden');
        if (btnText) btnText.textContent = 'Verifying Credentials...';
        if (btnSpinner) btnSpinner.classList.remove('hidden');
        if (submitBtn) submitBtn.disabled = true;

        const formData = new FormData(form);
        const username = formData.get('username');
        const password = formData.get('password');
        const redirect = (formData.get('redirect') as string) || '/dashboard';

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password, redirect }),
          });

          const data = await res.json();

          if (res.ok && data.success) {
            if (btnText) btnText.textContent = 'Access Granted!';
            const rawTarget = String(data.redirect || redirect || '/dashboard').trim();
            const safeTarget =
              rawTarget.startsWith('/') && !rawTarget.startsWith('//') && !rawTarget.startsWith('/\\')
                ? rawTarget
                : '/dashboard';
            window.location.href = safeTarget;
          } else {
            throw new Error(data.error || 'Authentication failed');
          }
        } catch (err: any) {
          if (errorEl) {
            errorEl.textContent = err.message || 'Authentication error';
            errorEl.classList.remove('hidden');
          }
          if (btnText) btnText.textContent = 'AUTHENTICATE & UNLOCK MAINFRAME';
          if (btnSpinner) btnSpinner.classList.add('hidden');
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLogin);
  } else {
    initLogin();
  }
</script>
