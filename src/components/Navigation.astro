---
import { isAuthenticated } from '../lib/auth';

const authenticated = isAuthenticated(Astro.cookies);

const navItems = [
  { name: '3D Shop', href: '/', icon: '🍕' },
  { name: 'Resume', href: '/resume', icon: '📋' },
];

if (authenticated) {
  navItems.push({ name: 'Dashboard', href: '/dashboard', icon: '⚡' });
}
---

<nav class="fixed top-5 inset-x-0 z-50 flex justify-center px-4 pointer-events-none">
  <!-- Pizzeria Floating Island Nav -->
  <div class="pointer-events-auto flex items-center gap-1.5 p-1.5 rounded-2xl bg-[#0c0a09]/85 border border-white/15 backdrop-blur-xl shadow-2xl transition-all duration-300 hover:border-amber-500/40">
    
    <!-- Brand Pill -->
    <a href="/" class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-cream transition-colors group" title="Return to 3D Pizza Parlor">
      <span class="text-base group-hover:scale-110 transition-transform">🍕</span>
      <span class="text-xs font-mono font-black tracking-wide hidden sm:inline">MIKEY'S PIZZA</span>
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
    </a>

    <div class="h-4 w-px bg-white/10 mx-1"></div>

    <!-- Nav Items -->
    <div class="flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-3.5 py-1.5 rounded-xl text-xs font-mono font-bold text-ash-gray hover:text-cream hover:bg-white/10 transition-all flex items-center gap-1.5"
        >
          <span>{item.icon}</span>
          <span>{item.name}</span>
        </a>
      ))}
    </div>

    {authenticated && (
      <>
        <div class="h-4 w-px bg-white/10 mx-1"></div>
        <a
          href="/dashboard"
          class="px-3 py-1.5 rounded-xl text-xs font-mono font-bold uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500/30 transition-all flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Dashboard</span>
        </a>
      </>
    )}
  </div>
</nav>
